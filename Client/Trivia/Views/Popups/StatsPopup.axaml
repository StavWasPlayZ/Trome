<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:popups="clr-namespace:Trivia.ViewModels.Popups"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:CompileBindings="True"
             x:Class="Trivia.Views.Popups.StatsPopupView"
             x:DataType="popups:StatsPopupViewModel">

    <Design.DataContext>
        <popups:StatsPopupViewModel/>
    </Design.DataContext>
    
    <Border CornerRadius="30"
            Background="#FFCACA"
            Width="325"
            Height="400"
            VerticalAlignment="Center">
        
        <Panel>
            <DockPanel Margin="50">

                <StackPanel DockPanel.Dock="Top"
                            Margin="0 0 0 20"
                            Spacing="10">
                    <Border
                        Background="#F3BBBB"
                        CornerRadius="20"
                        Width="80"
                        Height="80"
                        Padding="8">
                            
                        <Svg Path="avares://Trivia/Assets/Icons/person.svg"
                             Css="* { fill: #4D264A }"/>
                            
                    </Border>
                        
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="#4D264A"
                        FontSize="40"
                        Text="{Binding User.Username}"/>
                </StackPanel>

                <Grid VerticalAlignment="Bottom"
                      RowDefinitions="Auto, 5, Auto, 5, Auto, 5, Auto"
                      ColumnDefinitions="*, Auto">
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">POINTS</TextBlock>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7"
                               Text="{
                                   Binding Stats.Points,
                                   FallbackValue='-----'
                               }"/>
                    
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">AVG. TIME/Q</TextBlock>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7"
                               Text="{
                                   Binding Stats.TimeOnQuestionsAvg,
                                   Converter={StaticResource InvalidStaterConverter},
                                   FallbackValue='-----'
                               }"/>
                    
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">ANSWERED</TextBlock>
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7"
                               Text="{
                                   Binding Stats.QuestionsAnswered,
                                   FallbackValue='-----'
                               }"/>
                    
                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">CORRECT</TextBlock>
                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7"
                               Text="{
                                   Binding Stats.QuestionsAnsweredCorrectly,
                                   FallbackValue='-----'
                               }"/>
                    
                </Grid>

            </DockPanel>
            
            <Button Command="{Binding CloseCommand}"
                    Theme="{StaticResource EmptyButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20">
                <TextBlock Foreground="#4d264a"
                           FontSize="40">
                    X
                </TextBlock>
            </Button>
        </Panel>
        
    </Border>

</UserControl>