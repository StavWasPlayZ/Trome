<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:game="clr-namespace:Trivia.ViewModels.Game"
             xmlns:controls="clr-namespace:Trivia.Controls"
             xmlns:listEntries="clr-namespace:Trivia.Controls.ListEntries"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Trivia.Views.Game.AfterGameView"
             x:DataType="game:AfterGameViewModel"
             x:Name="AfterGameViewModelControl">
    
    <Design.DataContext>
        <game:AfterGameViewModel/>
    </Design.DataContext>
    
    <Panel>
        <Panel.Background>
            <ImageBrush Source="avares://Trivia/Assets/drool-d-b1608556d649b5b943136ecc0df0fe1bc7ff644f.png"
                        Stretch="UniformToFill"/>
        </Panel.Background>
        
        <ScrollViewer>
            <Panel>
                <controls:TriviaBackButton Command="{Binding NavigateBackCommand}"/>
                
                <StackPanel>

                    <Border Height="315">
                    
                        <Border Background="#ffb43a"
                                VerticalAlignment="Bottom"
                                CornerRadius="20"
                                Width="700"
                                Height="235">
                            
                            <Panel>
                                
                                <Panel ClipToBounds="True">
                                    
                                    <!-- Back trophy -->
                                    
                                    <Svg Path="avares://Trivia/Assets/Icons/trophy.svg"
                                         Stretch="Uniform"
                                         Css="* { fill: #ffbc53; } "
                                         Height="350"/>
                                    
                                    <!-- Left trophy -->
                                    
                                    <Svg Path="avares://Trivia/Assets/Icons/trophy.svg"
                                         Stretch="Fill"
                                         Css="* { fill: #ffc266; } "
                                         Width="200"
                                         Height="200"
                                         VerticalAlignment="Bottom"
                                         HorizontalAlignment="Left"
                                         RenderTransform="rotate(-20deg) translate(-35px, 50px)"/>
                                    
                                    <!-- Right trophy -->
                                    
                                    <Svg Path="avares://Trivia/Assets/Icons/trophy.svg"
                                         Stretch="Fill"
                                         Css="* { fill: #ffc266; } "
                                         Width="200"
                                         Height="200"
                                         VerticalAlignment="Bottom"
                                         HorizontalAlignment="Right"
                                         RenderTransform="rotate(20deg) translate(35px, 50px)"/>
                                    
                                </Panel>
                                
                                <!--
                                For the top margin:
                                
                                The tb margin is 10.
                                The PFP thus hovers an additional 10px.
                                The PFP is of size 100, hovering with half its size.
                                
                                10 - 100/2 = -40.
                                -->
                                <StackPanel HorizontalAlignment="Center"
                                            Margin="0 -40 0 20">
                                    <StackPanel.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </StackPanel.Styles>
                                    
                                    <Border Background="#ffdbb8"
                                            Width="100"
                                            Height="100"
                                            RenderTransform="translateY(-10px)"
                                            CornerRadius="20">
                                        
                                        <Panel>
                                            <Svg Path="avares://Trivia/Assets/Icons/person.svg"
                                                 Stretch="Uniform"
                                                 Css="* { fill: #c9731e; } " />
                                            
                                            <Svg Path="avares://Trivia/Assets/Icons/crown.svg"
                                                 Stretch="Uniform"
                                                 Css="* { fill: #ffb43a; } "
                                                 Height="50"
                                                 VerticalAlignment="Top"
                                                 HorizontalAlignment="Right"
                                                 RenderTransform="rotate(20deg) translate(10px, -27px)"/>
                                        </Panel>
                                        
                                    </Border>
                                    
                                    <StackPanel>
                                        <StackPanel.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="Foreground" Value="#ac631b"/>
                                                <Setter Property="LineHeight" Value="58"/>
                                            </Style>
                                        </StackPanel.Styles>
                                        
                                        <TextBlock FontSize="80">WINNER</TextBlock>
                                        <TextBlock FontSize="45"
                                                   Text="{Binding WinnerResults.User.Username}"/>
                                    </StackPanel>
                                    
                                    <Panel Height="2"/>
                                    
                                    <StackPanel Spacing="2">
                                        <StackPanel.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="Foreground" Value="#B7722D"/>
                                            </Style>
                                        </StackPanel.Styles>
                                        
                                        <TextBlock FontSize="30">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} • {1}">
                                                    <Binding Path="WinnerResults.Points"/>
                                                    <Binding Path="WinnerResults.Playtime"
                                                             Converter="{StaticResource TimeSpanToStringConverter}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock FontSize="25">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="AVG. {0} • {1}/{2} CORRECT">
                                                    <Binding Path="WinnerResults.AverageAnswerTime"
                                                             Converter="{StaticResource TimeSpanToStringConverter}"/>
                                                    <Binding Path="WinnerResults.CorrectAnswerCount"/>
                                                    <Binding Path="RoomModel.Data.QuestionsCount"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                
                            </Panel>
                                
                        </Border>
                        
                    </Border>
                    
                    <StackPanel IsVisible="{
                                    Binding List2Results,
                                    Converter={x:Static ObjectConverters.IsNotNull}
                                }">
                        
                        <controls:TriviaUsersList Background="#FFCCA2"
                                                  Width="470"
                                                  Margin="0 15">
                            <ListBox ItemsSource="{Binding List2Results}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <listEntries:AfterGameListEntry
                                            Result="{Binding}"
                                            RoomModel="{
                                                Binding DataContext.RoomModel,
                                                ElementName=AfterGameViewModelControl
                                            }"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--FIXME: These styles are copy-pasted from StatisticsView. -->
                            <!-- Find a way to DRY it. -->
                            <controls:TriviaUsersList.Styles>
                                
                                <Style Selector="TextBlock.secondary-text">
                                    <Setter Property="FontSize" Value="26"/>
                                </Style>
                                
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0 3"/>
                                </Style>
                                <Style Selector="listEntries|AfterGameListEntry">
                                    <Setter Property="Padding" Value="10 10"/>
                                </Style>
                                
                                <Style Selector="listEntries|AfterGameListEntry Border#PART_Pfp">
                                    <Setter Property="Width" Value="56"/>
                                    <Setter Property="Height" Value="56"/>
                                </Style>
                                
                                <Style Selector="ListBoxItem:nth-child(1)">
                                    <Style Selector="^ > listEntries|AfterGameListEntry">
                                        <Setter Property="Background" Value="#b4483a"/>
                                        
                                        <Style Selector="^ Border#PART_Pfp">
                                            <Setter Property="Background" Value="#ffa69a"/>
                                        
                                            <Style Selector="^ > Svg">
                                                <Setter Property="Css" Value="* { fill: #9d4236; }"/>
                                            </Style>
                                        </Style>
                                        
                                        <Style Selector="^ TextBlock.primary-text">
                                            <Setter Property="Foreground" Value="#ffa69a"/>
                                        </Style>
                                        <Style Selector="^ TextBlock.secondary-text">
                                            <Setter Property="Foreground" Value="#712e25"/>
                                        </Style>
                                    </Style>
                                    
                                    <Style Selector="^:pointerover > listEntries|AfterGameListEntry">
                                        <Setter Property="Background" Value="#B45C46"/>
                                    </Style>
                                    <Style Selector="^:pressed listEntries|AfterGameListEntry">
                                        <Setter Property="Background" Value="#A74336"/>
                                    </Style>
                                </Style>
                                
                                <Style Selector="ListBoxItem:nth-child(2)">
                                    <Style Selector="^ > listEntries|AfterGameListEntry">
                                        <Setter Property="Background" Value="#d29188"/>
                                                        
                                        <Style Selector="^ Border#PART_Pfp">
                                            <Setter Property="Background" Value="#ffcdc7"/>
                                                        
                                            <Style Selector="^ > Svg">
                                                <Setter Property="Css" Value="* { fill: #ae6e65; }"/>
                                            </Style>
                                        </Style>
                                                        
                                        <Style Selector="^ TextBlock.primary-text">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                        <Style Selector="^ TextBlock.secondary-text">
                                            <Setter Property="Foreground" Value="#975f58"/>
                                        </Style>
                                    </Style>
                                                    
                                    <Style Selector="^:pointerover > listEntries|AfterGameListEntry">
                                        <Setter Property="Background" Value="#D29C97"/>
                                    </Style>
                                    <Style Selector="^:pressed listEntries|AfterGameListEntry">
                                        <Setter Property="Background" Value="#C3867E"/>
                                    </Style>
                                </Style>
                                
                            </controls:TriviaUsersList.Styles>
                            
                        </controls:TriviaUsersList>
                        
                        <Border IsVisible="{
                                    Binding List3Results,
                                    Converter={x:Static ObjectConverters.IsNotNull}
                                }">
                            
                            <Border Background="rgba(0, 0, 0, 0.3)"
                                    CornerRadius="30"
                                    Margin="50 35 50 0"
                                    Padding="0 15">
                                <!--TODO: This is copied directly from StatisticsView. Make it its own control -->
                                <controls:TriviaUsersList Margin="50 0"
                                                          CornerRadius="30">
                                    <ListBox ItemsSource="{Binding List3Results}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <listEntries:AfterGameListEntry Result="{Binding}"
                                                                                RoomModel="{
                                                                                    Binding DataContext.RoomModel,
                                                                                    ElementName=AfterGameViewModelControl
                                                                                }"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                
                                    <controls:TriviaUsersList.Styles>
                                        <Style Selector="Border#PART_Pfp">
                                            <Setter Property="Width" Value="30"/>
                                            <Setter Property="Height" Value="30"/>
                                            <Setter Property="Padding" Value="3"/>
                                        </Style>
                                    </controls:TriviaUsersList.Styles>
                                
                                </controls:TriviaUsersList>
                            </Border>
                            
                        </Border>
                        
                    </StackPanel>
                    
                    <controls:TriviaButton Command="{Binding NavigateBackCommand}"
                                           Text="RETURN TO LOBBY"
                                           Width="335"
                                           Margin="0 60"
                                           Background="#362034"
                                           BorderBrush="#DC7D62"
                                           IconColor="#ffbbbb"
                                           BorderBrushSelected="#DC9683"
                                           BorderBrushPressed="#DC7D62"
                                           BorderThickness="5"
                                           BorderThicknessSelected="6"
                                           IconSvgPath="avares://Trivia/Assets/Icons/play_arrow.svg"
                                           IconMargin="0 7 -10 7">
                        
                        <controls:TriviaButton.Styles>
                            <Style Selector="controls|TriviaButton /template/ Button /template/ ContentPresenter">
                                <Setter Property="BoxShadow" Value="0 6 7 0 #4f000000"/>
                            </Style>
                        </controls:TriviaButton.Styles>
                        
                    </controls:TriviaButton>

                </StackPanel>
            </Panel>
        </ScrollViewer>
        
    </Panel>
</UserControl>
