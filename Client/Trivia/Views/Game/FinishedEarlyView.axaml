<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:game="clr-namespace:Trivia.ViewModels.Game"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Trivia.Views.Game.FinishedEarlyView"
             x:DataType="game:FinishedEarlyViewModel">
    
    <Design.DataContext>
        <game:FinishedEarlyViewModel/>
    </Design.DataContext>
    
    <Panel>
        <Panel.Background>
            <ImageBrush Source="avares://Trivia/Assets/drool-d-b1608556d649b5b943136ecc0df0fe1bc7ff644f.png"
                        Stretch="UniformToFill"/>
        </Panel.Background>
        
        <Panel Background="rgba(0, 0, 0, .3)">
            
            <Border
                Padding="2,5,6,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="0,0,10,0"
                Background="rgba(0, 0, 0, .3)">
                
                <Grid ColumnDefinitions="*, Auto">
                    
                    <Svg Grid.Column="0"
                         Path="avares://Trivia/Assets/Icons/crown.svg"
                         Css="* { fill: #FFB43B; }"
                         Height="40"
                         Margin="0,0,10,0"/>
                    
                    <TextBlock Grid.Column="1">username</TextBlock>
                </Grid>
                
            </Border>
            
            <Border
                Background="rgba(0, 0, 0, .3)"
                Margin="20 70 20 25"
                CornerRadius="25"
                BoxShadow="0 5 0 0 #1f000000">
                
                <StackPanel VerticalAlignment="Center"
                            Margin="60 0">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="FontSize" Value="40"/>
                        </Style>
                    </StackPanel.Styles>
                    
                    <TextBlock VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"
                               FontSize="60">
                        FINISHED EARLY.
                    </TextBlock>
                    <TextBlock VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               FontSize="40"
                               Opacity="0.8"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="{Binding EndingLine}"/>
                </StackPanel>
                
            </Border>
        </Panel>
        
    </Panel>
</UserControl>
