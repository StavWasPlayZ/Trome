<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trivia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Trivia.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Trivia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="600"
        x:Name="Window"
        CanResize="False"
        Title="Trivia">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <Image Source="avares://Trivia/Assets/blobs-l-b49caff1a7941d98b60902da64956ad85dfbe4f9.png"
               Stretch="UniformToFill" />

        <Grid
            VerticalAlignment="Center"
            ColumnDefinitions="*, *"
            Height="{
                Binding Height, ElementName=Window,
                Converter={StaticResource MultiplicationConverter},
                ConverterParameter=0.55
            }">
    
            <!-- Left Panel -->
            
            <Border Grid.Column="0"
                    CornerRadius="0 25 25 0"
                    Background="rgba(0, 0, 0, 190)"
                    Padding="50 20 30 20">
        
                <Grid
                    RowDefinitions="*, Auto">
    
                    <StackPanel Grid.Row="0"
                                Spacing="7">
    
                        <controls:TriviaButton x:Name="PlayButton"
                                               Text="PLAY"
                                               Background="#362034"
                                               BorderBrush="#b92e2b"
                                               IconColor="#ffbbbb"
                                               BorderBrushSelected="#D93040"
                                               BorderThickness="3"
                                               IconSvgPath="avares://Trivia/Assets/Icons/play_arrow.svg"
                                               IconMargin="-7 7 -10 7"/>
                        <controls:TriviaButton x:Name="StatsButton"
                                               Text="STATISTICS"
                                               BorderBrushSelected="#6154A3"
                                               IconSvgPath="avares://Trivia/Assets/Icons/leaderboard.svg"/>
                        <controls:TriviaButton x:Name="AboutButton"
                                               Text="ABOUT"
                                               IconSvgPath="avares://Trivia/Assets/Icons/info.svg"/>
    
                    </StackPanel>
    
                    <Grid Grid.Row="1"
                                ColumnDefinitions="*, 7, Auto">
                        <controls:TriviaButton Grid.Column="0"
                                               x:Name="ExitButton"
                                               Text="EXIT"
                                               BorderBrush="#F2B2B8"
                                               BorderBrushSelected="Crimson"/>
                        
                        <Panel Grid.Column="1" />

                        <controls:TriviaButton Grid.Column="2"
                                               x:Name="SettingsButton"
                                               IsIconButton="True"
                                               IconSvgPath="avares://Trivia/Assets/Icons/settings.svg"
                                               BorderBrushSelected="LightGray"
                                               CornerRadius="5 5 0 5"/>
                    </Grid>
    
                </Grid>
    
            </Border>
    
            <Border Grid.Column="1">
                <Image Source="avares://Trivia/Assets/logo.png"/>
            </Border>
    
        </Grid>
        
        <!-- Username & Logout -->
        
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="7"
            Margin="20 10">
            
            <!-- TODO: Maybe add SVG border -->
            
            <Button x:Name="LogoutButton"
                    Padding="0"
                    Background="Transparent">
                
                <Svg Path="avares://Trivia/Assets/Icons/logout.svg"
                     Height="40"/>
                
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Transitions">
                            <Transitions/>
                        </Setter>
                        
                        <Style Selector="^:pointerover">
                            <Style Selector="^ /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        
                            <Style Selector="^ > Svg">
                                <Setter Property="Css" Value="* { fill: #b92e2b; }" />
                                
                                <Setter Property="RenderTransform">
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>                            
                                </Setter>
                            </Style>
                        </Style>
                        
                        <Style Selector="^:pressed">
                            <Setter Property="RenderTransform" Value="none"/>
                            
                            <Style Selector="^ > Svg">
                                <Setter Property="RenderTransform">
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>                            
                                </Setter>
                            </Style>
                        </Style>
                        
                        <Style Selector="^:not(:pointerover) > Svg">
                            <Setter Property="Css" Value="* { fill: #d74351; }" />
                        </Style>
                    </Style>
                    
                </Button.Styles>
            </Button>
                
            
            <TextBlock FontSize="30"
                       VerticalAlignment="Center">Username</TextBlock>
            
        </StackPanel>
    </Panel>

</Window>
