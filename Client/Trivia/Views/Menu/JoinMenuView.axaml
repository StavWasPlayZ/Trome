<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmmenu="clr-namespace:Trivia.ViewModels.Menu"
             xmlns:controls="clr-namespace:Trivia.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:CompileBindings="True"
             x:Class="Trivia.Views.Menu.JoinMenuView"
             x:DataType="vmmenu:JoinMenuViewModel"
             x:Name="JoinMenuViewControl">

    <Panel>
        <Image Source="avares://Trivia/Assets/blobs-l-b49caff1a7941d98b60902da64956ad85dfbe4f9.png"
               Stretch="UniformToFill" />

        <controls:MenuPanelExpanded Title="JOIN"
                                    BackButtonCommand="{Binding BackButtonCommand}">
            
            <Panel>
                
                <Grid ColumnDefinitions="*, Auto"
                      Margin="20 0">
                    <ListBox x:Name="RoomListBox"
                             Grid.Column="0"
                             SelectionMode="Single, Toggle"
                             Background="Transparent"
                             ClipToBounds="False"
                             Margin="0 0 10 0">
                    
                        <ListBox.ItemsSource>
                            naorsdsadasdasdasdjtffjghfgjhfghjfghj
                        </ListBox.ItemsSource>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, Auto, *">
                                    
                                    <Border Grid.Column="0" Background="#ffb0a1"
                                            Height="55"
                                            Width="55"
                                            Padding="12"
                                            CornerRadius="15"
                                            Margin="15 0">
                                        
                                        <Svg Path="avares://Trivia/Assets/Icons/sports_kabaddi.svg"
                                             Css="* { fill: #2f223b; }"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="30">ROOM</TextBlock>
                                            <TextBlock FontSize="22"
                                                       VerticalAlignment="Center"
                                                       Opacity=".7"
                                                       Text=" • USERNAME"/>
                                        </StackPanel>
                                        
                                        <TextBlock FontSize="15"
                                                   Opacity=".4">
                                            1/6 PLAYERS • 25 QUESTIONS
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Background="#f9be82"
                                            CornerRadius="5"
                                            Width="80"
                                            Height="40"
                                            ClipToBounds="False">
                                        
                                        <Button.Styles>
                                            <Style Selector="Button /template/ ContentPresenter">
                                                <Setter Property="BoxShadow" Value="0 3 3 #4f000000"/>
                                            </Style>
                                            
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#F1B67C"/>
                                            </Style>
                        
                                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#DFA871"/>
                                            </Style>
                                        </Button.Styles>
                                        
                                        <Svg Path="avares://Trivia/Assets/Icons/login.svg"
                                             Stretch="Uniform"
                                             Css="* { fill: #2f223b; } " />
                                    </Button>
                                    
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        
                        <ListBox.Styles>
                            <Style Selector="ListBox > ListBoxItem">
                                <Setter Property="Background" Value="#A52151"/>
                                <Setter Property="Margin" Value="0 2"/>
                                <Setter Property="Padding" Value="10 9"/>
                                
                                <Style Selector="^:nth-child(1)">
                                    <Setter Property="CornerRadius" Value="15 15 0 0"/>
                                </Style>
                                <Style Selector="^:nth-last-child(1)">
                                    <Setter Property="CornerRadius" Value="0 0 5 5"/>
                                </Style>

                                <Style Selector="^:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#921E48"/>
                                </Style>
                                <Style Selector="^:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#8A2464"/>
                                </Style>
                                <Style Selector="^:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#93256C"/>
                                </Style>
                                <Style Selector="^:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#9B2772"/>
                                </Style>
                            </Style>
                            
                            <Style Selector="ListBox /template/ ScrollViewer">
                                <!-- Pad the top and bottom of the list -->
                                <Style Selector="^ VirtualizingStackPanel">
                                    <Setter Property="Margin" Value="0 20 0 275"/>
                                </Style>
                                
                                <Setter Property="ClipToBounds" Value="False"/>
                                
                                <Style Selector="^ /template/ ScrollBar:vertical">
                                    <!-- Bring the scrollbar a bit right -->
                                    <Setter Property="RenderTransform" Value="translateX(23px)"/>
                                    
                                    <Setter Property="AllowAutoHide" Value="False"/>
                                    
                                    
                                    <Setter Property="Margin" Value="0 15"/>
                                    
                                    <Style Selector="^ Track">
                                        <Setter Property="Margin" Value="0 3"/>
                                        
                                        <Style Selector="^ Thumb">
                                            <Setter Property="Background" Value="#f9be82"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                            
                                            <Style Selector="^:pointerover > Border">
                                                <Setter Property="Background" Value="#E4AE76"/>
                                            </Style>
                                            <Style Selector="^:pressed > Border">
                                                <Setter Property="Background" Value="#FFC792"/>
                                            </Style>
                                        </Style>
                                    </Style>
                                    
                                    <Style Selector="^ Rectangle#TrackRect">
                                        <Setter Property="Fill" Value="Transparent"/>
                                    </Style>
                                    
                                    
                                    <!-- Arrows -->
                                    
                                    <Style Selector="^ RepeatButton">
                                        
                                        <Style Selector="^#PART_LineUpButton, ^#PART_LineDownButton">
                                            <Style Selector="^ TextBlock">
                                                <Setter Property="Foreground" Value="#D9555A"/>
                                                <Setter Property="FontSize" Value="18"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </Style>
                                        
                                        <Style Selector="^:pointerover#PART_LineUpButton, ^:pointerover#PART_LineDownButton">
                                            <Style Selector="^ TextBlock">
                                                <Setter Property="Foreground" Value="#C74D52"/>
                                            </Style>
                                        </Style>
                                        
                                        <Style Selector="^:pressed#PART_LineUpButton, ^:pressed#PART_LineDownButton">
                                            <Style Selector="^ TextBlock">
                                                <Setter Property="Foreground" Value="#B7474C"/>
                                            </Style>
                                        </Style>
                                        
                                        <Style Selector="^#PART_LineUpButton">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <TextBlock>⮝</TextBlock>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>
                                        <Style Selector="^#PART_LineDownButton">
                                            <Setter Property="Template">
                                                <ControlTemplate>
                                                    <TextBlock>⮟</TextBlock>
                                                </ControlTemplate>
                                            </Setter>
                                        </Style>
                                    </Style>
                                </Style>
                            </Style>
                            
                        </ListBox.Styles>
                    </ListBox>
                    
                    
                    <!-- Right Panel -->
                    
                    <Grid Grid.Column="1"
                          x:Name="RoomInfoPanel"
                          ColumnDefinitions="Auto, *"
                          Width="350">
                        <Panel Grid.Column="0" Width="20"/>
                        
                        <Grid.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Width"
                                                  Duration="{Binding #JoinMenuViewControl.RoomInfoPanelAnimationTime}"
                                                  Easing="CubicEaseOut"/>
                            </Transitions>
                        </Grid.Transitions>
                        
                        <Border Grid.Column="1"
                                Background="#8a2464"
                                Margin="0 20"
                                CornerRadius="30"
                                ClipToBounds="True">
                            
                            <Grid RowDefinitions="Auto, *, Auto"
                                  Margin="30">
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Margin="10">
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#ffb0a1"
                                                Width="90"
                                                Height="90"
                                                Padding="20"
                                                CornerRadius="15"
                                                Margin="15 0">
                                            
                                            <Svg Path="avares://Trivia/Assets/Icons/sports_kabaddi.svg"
                                                 Css="* { fill: #2f223b; }"/>
                                        </Border>
                                        
                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="0 0 0 10">
                                            <TextBlock FontSize="60">
                                                ROOM
                                            </TextBlock>
                                            <TextBlock FontSize="20"
                                                       Opacity=".6">1/6 PLAYERS</TextBlock>
                                        </StackPanel>
                                        
                                    </StackPanel>
                                    
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1">
                                    <Grid ColumnDefinitions="Auto, *"
                                          Margin="10"
                                          Opacity=".9">
                                        
                                        <TextBlock Grid.Column="0"
                                                    FontSize="37"
                                                   Text="ADMIN: "/> 
                                        <TextBlock Grid.Column="1"
                                                    FontSize="37"
                                                   Foreground="#EAACC4"
                                                   TextAlignment="End"
                                                   Text="USERNAME"/>
                                    </Grid>
                                    
                                    <Grid RowDefinitions="Auto, Auto"
                                          ColumnDefinitions="Auto, *"
                                          Margin="0 10">
                                        
                                        <Grid.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize" Value="25" />
                                                <Setter Property="Margin" Value="0 0 0 2" />
                                            </Style>
                                            
                                            <Style Selector="TextBlock[(Grid.Column)=0]">
                                                <Setter Property="Foreground" Value="#f9be82" />
                                                <Setter Property="Margin" Value="0 0 7 2" />
                                            </Style>
                                        </Grid.Styles>
                                        
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0">
                                            • 25
                                        </TextBlock>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1">
                                            QUESTIONS
                                        </TextBlock>
                                        
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0">
                                            • 10
                                        </TextBlock>
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1">
                                            SEC/Q
                                        </TextBlock>
                                        
                                    </Grid>
                                    
                                </StackPanel>
                                
                                <Button Grid.Row="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Background="#f9be82"
                                        CornerRadius="5"
                                        Width="240"
                                        Height="55"
                                        ClipToBounds="False">
                                        
                                    <Button.Styles>
                                        <Style Selector="Button /template/ ContentPresenter">
                                            <Setter Property="BoxShadow" Value="0 3 3 #3f000000"/>
                                        </Style>
                                            
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#F1B67C"/>
                                        </Style>
                        
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#DFA871"/>
                                        </Style>
                                    </Button.Styles>
                                        
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Svg Grid.Column="0" Path="avares://Trivia/Assets/Icons/login.svg"
                                             Stretch="Uniform"
                                             Css="* { fill: #2f223b; } " />
                                        
                                        <TextBlock Grid.Column="1" Foreground="#2f223b"
                                                   HorizontalAlignment="Center"
                                                   FontSize="40">
                                            JOIN
                                        </TextBlock>
                                    </Grid>
                                </Button>
                                
                            </Grid>
                            
                        </Border>
                        
                    </Grid>
                </Grid>
                
                
                <!-- New Room button -->
                
                <Button Command="{Binding NewRoomButtonCommand}"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Background="#ffcaca"
                        CornerRadius="15 15 0 0"
                        Padding="15 7">
                    
                    <Button.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:.025"/>
                        </Transitions>
                    </Button.Transitions>
                    
                    <Button.Styles>
                        <!-- Because for some reason it's 1px offset -->
                        <Style Selector="Button">
                            <Setter Property="RenderTransform" Value="translateY(1px)"/>
                        </Style>
                        
                        <Style Selector="Button:pointerover">
                            <Setter Property="RenderTransform" Value="translateY(4px)"/>
                            
                            <Style Selector="^ /template/ ContentPresenter">
                                <Setter Property="Background" Value="#F2B8B8"/>
                            </Style>
                        </Style>
                        
                        <Style Selector="Button:pressed">
                            <Setter Property="RenderTransform" Value="translateY(8px)"/>
                            
                            <Style Selector="^ /template/ ContentPresenter">
                                <Setter Property="Background" Value="#E8A6A9"/>
                            </Style>
                        </Style>
                    </Button.Styles>
                    
                    <StackPanel Orientation="Horizontal"
                                Spacing="7">
                        
                        <TextBlock
                            Foreground="#4d264a"
                            FontWeight="Light"
                            Padding="3 0">
                            +
                        </TextBlock>
                        
                        <TextBlock
                            Foreground="#4d264a"
                            FontWeight="Light">
                            NEW ROOM
                        </TextBlock>
                    </StackPanel>
                    
                </Button>
            </Panel>
            
        </controls:MenuPanelExpanded>
    </Panel>

</UserControl>
