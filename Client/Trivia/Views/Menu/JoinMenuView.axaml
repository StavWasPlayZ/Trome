<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmmenu="clr-namespace:Trivia.ViewModels.Menu"
             xmlns:controls="clr-namespace:Trivia.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:CompileBindings="True"
             x:Class="Trivia.Views.Menu.JoinMenuView"
             x:DataType="vmmenu:JoinMenuViewModel">

    <Panel>
        <Image Source="avares://Trivia/Assets/blobs-l-b49caff1a7941d98b60902da64956ad85dfbe4f9.png"
               Stretch="UniformToFill" />

        <controls:MenuPanelExpanded Title="JOIN"
                                    BackButtonCommand="{Binding BackButtonCommand}">
            
            <Panel>
                <ListBox SelectionMode="Single, Toggle"
                         Margin="20 0"
                         Background="Transparent">
                    
                    <ListBox.ItemsSource>
                        naorsdsadasdasdasd
                    </ListBox.ItemsSource>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                
                                <Border Background="#ffb0a1"
                                        Height="50"
                                        Width="50"
                                        Padding="12"
                                        CornerRadius="15"
                                        Margin="15 0">
                                    
                                    <Svg Path="avares://Trivia/Assets/Icons/sports_kabaddi.svg"
                                         Css="* { fill: #2f223b; }"/>
                                </Border>
                                
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="30">ROOM</TextBlock>
                                    
                                    <TextBlock FontSize="15"
                                               Foreground="rgba(255, 255, 255, .4)">1/6 PLAYERS</TextBlock>
                                </StackPanel>
                                
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    
                    <ListBox.Styles>
                        <Style Selector="ListBox > ListBoxItem">
                            <Setter Property="Background" Value="#A52151"/>
                            <Setter Property="Margin" Value="0 2"/>
                            <Setter Property="Padding" Value="10 7"/>
                            
                            <Style Selector="^:nth-child(1)">
                                <Setter Property="Margin" Value="0 40 0 2"/>
                                <Setter Property="CornerRadius" Value="15 15 0 0"/>
                            </Style>
                            <Style Selector="^:nth-last-child(1)">
                                <Setter Property="Margin" Value="0 2 0 275"/>
                            </Style>

                            <Style Selector="^:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#921E48"/>
                            </Style>
                            <Style Selector="^:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#8A2464"/>
                            </Style>
                            <Style Selector="^:selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#93256C"/>
                            </Style>
                            <Style Selector="^:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="#9B2772"/>
                            </Style>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
                
                <Button Command="{Binding NewRoomButtonCommand}"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Background="#ffcaca"
                        CornerRadius="15 15 0 0"
                        Padding="15 7 15 15">
                    
                    <Button.Transitions>
                        <Transitions/>
                    </Button.Transitions>
                    
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="RenderTransform" Value="translateY(8px)"/>
                        </Style>
                        
                        <Style Selector="Button:pointerover">
                            <Setter Property="RenderTransform" Value="translateY(5px)"/>
                            
                            <Style Selector="^ /template/ ContentPresenter">
                                <Setter Property="Background" Value="#F2B8B8"/>
                            </Style>
                        </Style>
                        
                        <Style Selector="Button:pressed">
                            <Setter Property="RenderTransform" Value="translateY(10px)"/>
                            
                            <Style Selector="^ /template/ ContentPresenter">
                                <Setter Property="Background" Value="#E8A6A9"/>
                            </Style>
                        </Style>
                    </Button.Styles>
                    
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="7">
                        
                        <TextBlock
                            Foreground="#4d264a"
                            FontWeight="Light"
                            Padding="3 0">
                            +
                        </TextBlock>
                        
                        <TextBlock
                            Foreground="#4d264a"
                            FontWeight="Light">
                            NEW ROOM
                        </TextBlock>
                    </StackPanel>
                    
                </Button>
            </Panel>
            
        </controls:MenuPanelExpanded>
    </Panel>

</UserControl>
