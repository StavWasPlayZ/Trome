<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmmenu="clr-namespace:Trivia.ViewModels.Menu"
             xmlns:controls="clr-namespace:Trivia.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:CompileBindings="True"
             x:Class="Trivia.Views.Menu.SignupView"
             x:DataType="vmmenu:SignupViewModel">
    <Panel>
        <Panel.Background>
            <ImageBrush Source="avares://Trivia/Assets/blobs-l-b49caff1a7941d98b60902da64956ad85dfbe4f9.png"
                   Stretch="UniformToFill" />            
        </Panel.Background>
        
        <controls:TriviaMenuPanel Title="SIGNUP"
                                  DisplayBackButton="False"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
            
            <StackPanel Margin="40,40,40,25"
                        HorizontalAlignment="Center">
                
                <Grid RowDefinitions="50, 50, 50, 50, 50, 50"
                      ColumnDefinitions="Auto, *"
                      HorizontalAlignment="Center"
                      Margin="10">
                    
                    <Grid.Styles>
                        <Style Selector="TextBlock[(Grid.Column)=1]">
                            <Setter Property="Width" Value="250"/>
                            <Setter Property="TextAlignment" Value="End"/>
                        </Style>
                    </Grid.Styles>
                    
                    <TextBlock Grid.Row="0"
                               Grid.Column="0">
                        USERNAME
                    </TextBlock>
                    <TextBlock Grid.Row="0"
                               Grid.Column="1">
                        TODO
                    </TextBlock>
                    
                    <TextBlock Grid.Row="1"
                               Grid.Column="0">
                        EMAIL
                    </TextBlock>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1">
                        TODO
                    </TextBlock>
                    <TextBlock Grid.Row="2"
                               Grid.Column="0">
                        PASSWORD
                    </TextBlock>
                    <TextBlock Grid.Row="2"
                               Grid.Column="1">
                        TODO
                    </TextBlock>
                    <TextBlock Grid.Row="3"
                               Grid.Column="0">
                        REPEAT
                    </TextBlock>
                    <TextBlock Grid.Row="3"
                               Grid.Column="1">
                        TODO
                    </TextBlock>
                    <TextBlock Grid.Row="4"
                               Grid.Column="0">
                        PHONE
                    </TextBlock>
                    <TextBlock Grid.Row="4"
                               Grid.Column="1">
                        TODO
                    </TextBlock>
                    <TextBlock Grid.Row="5"
                               Grid.Column="0">
                        ADDRESS
                    </TextBlock>
                    <TextBlock Grid.Row="5"
                               Grid.Column="1">
                        TODO
                    </TextBlock>
                    
                </Grid>


                <Grid RowDefinitions="*, Auto"
                      Margin="0, 10">
                    <Button Grid.Row="0" HorizontalAlignment="Center">
                        <!-- TODO-Add command(s) here -->
                        <controls:TriviaButton 
                            Text="SIGNUP"
                            Background="#362034"
                            BorderBrush="#b92e2b"
                            IconColor="#ffbbbb"
                            BorderBrushSelected="#D93040"
                            BorderBrushPressed="#AA2C2F"
                            BorderThickness="3"
                            Padding="100,0"/>
                    </Button>
                    <Grid Grid.Row="1" 
                          HorizontalAlignment="Center" 
                          ColumnDefinitions="Auto,Auto">
                        <TextBlock Grid.Column="0" Margin="5,0">OR</TextBlock>
                        <controls:Underlined Grid.Column="1" 
                                             Margin="5,0"
                                             Foreground="#FF627C">
                            <TextBlock
                                Foreground="#FF627C">LOG IN</TextBlock>
                        </controls:Underlined>
                    </Grid>
                        
                </Grid>

            </StackPanel>
            
        </controls:TriviaMenuPanel>
    </Panel>
</UserControl>
