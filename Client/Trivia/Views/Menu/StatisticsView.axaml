<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Trivia.Controls"
             xmlns:vmmenu="clr-namespace:Trivia.ViewModels.Menu"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:CompileBindings="True"
             x:Class="Trivia.Views.Menu.StatisticsView"
             x:DataType="vmmenu:StatisticsViewModel">
    
    <Panel>
        <Panel.Background>
            <ImageBrush Source="avares://Trivia/Assets/blobs-l-b49caff1a7941d98b60902da64956ad85dfbe4f9.png"
                        Stretch="UniformToFill" />
        </Panel.Background>

        <controls:TriviaMenuPanel Title="STATISTICS"
                                    BackButtonCommand="{Binding NavigateBackCommand}">
            
            <Grid RowDefinitions="Auto, 14, *"
                  Margin="50 50 50 0">
                
                <Border Grid.Row="0"
                        Background="#4DFFA6A6"
                        CornerRadius="30">
                    <Grid ColumnDefinitions="*, 5, *"
                          Margin="7"
                          Height="180">
                        
                        <!-- <Grid.Styles> -->
                        <!--     <Style Selector="controls|TriviaUsersList"> -->
                        <!--         <Setter Property="Margin" Value="3"></Setter> -->
                        <!--     </Style> -->
                        <!-- </Grid.Styles> -->
                        
                        <controls:TriviaUsersList Grid.Column="0"
                                                  VerticalAlignment="Top">
                            <ListBox ItemsSource="12">
                                
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="25"
                                                       Margin="5 0 2 0"
                                                       Text="{Binding StringFormat={}{0}.}"/>

                                            <Border Background="#ffbcf8"
                                                    Height="58"
                                                    Width="58"
                                                    Padding="6"
                                                    CornerRadius="10"
                                                    Margin="10 0 15 0">
        
                                                <Svg Path="avares://Trivia/Assets/Icons/person.svg"
                                                     Css="* { fill: #813e7a; }"/>
                                            </Border>
        
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="30">
                                                USERNAME
                                            </TextBlock>
        
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                
                            </ListBox>
                        </controls:TriviaUsersList>
                        
                        <controls:TriviaUsersList Grid.Column="2">
                            <ListBox ItemsSource="345">
                                
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="25"
                                                       Margin="5 0 2 0"
                                                       Text="{Binding StringFormat={}{0}.}"/>
        
                                            <Border Background="#ffbcf8"
                                                    Height="31"
                                                    Width="31"
                                                    Padding="2"
                                                    CornerRadius="8"
                                                    Margin="10 0 15 0">
        
                                                <Svg Path="avares://Trivia/Assets/Icons/person.svg"
                                                     Css="* { fill: #813e7a; }"/>
                                            </Border>
        
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="30">
                                                USERNAME
                                            </TextBlock>
        
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                
                            </ListBox>
                        </controls:TriviaUsersList>
                        
                    </Grid>
                </Border>
                
                <controls:TriviaUsersList Grid.Row="2"
                                          Margin="125 0"
                                          CornerRadius="30 30 0 0">
                    <ListBox ItemsSource="678965999999999999999999999999999999999999">
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="25"
                                               Margin="5 0 2 0"
                                               Text="{Binding StringFormat={}{0}.}"/>
        
                                    <Border Background="#ffbcf8"
                                            Height="30"
                                            Width="30"
                                            Padding="2"
                                            CornerRadius="8"
                                            Margin="10 0 15 0">
        
                                        <Svg Path="avares://Trivia/Assets/Icons/person.svg"
                                             Css="* { fill: #813e7a; }"/>
                                    </Border>
        
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="30">
                                        USERNAME
                                    </TextBlock>
        
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:nth-last-child(1)">
                                <Setter Property="CornerRadius" Value="0 0 5 5"/>
                            </Style>
                        </ListBox.Styles>
                        
                    </ListBox>
                </controls:TriviaUsersList>
                
            </Grid>
            
            
        </controls:TriviaMenuPanel>

    </Panel>
    
</UserControl>
