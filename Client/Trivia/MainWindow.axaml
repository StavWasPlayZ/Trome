<Window xmlns="https://github.com/avaloniaui"
        xmlns:rxui="http://reactiveui.net"
        xmlns:app="clr-namespace:Trivia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trivia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Trivia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="600"
        CanResize="False"
        Title="Trivia"
        
        DetachedFromLogicalTree="OnDetachedFromLogicalTree">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <Panel>
        <rxui:RoutedViewHost
            Router="{Binding Router}"
            PageTransition="{x:Null}">
            
            <rxui:RoutedViewHost.DefaultContent>
                <TextBlock>why hello there</TextBlock>
            </rxui:RoutedViewHost.DefaultContent>
            
            <rxui:RoutedViewHost.ViewLocator>
                <app:ViewLocator/>
            </rxui:RoutedViewHost.ViewLocator>
            
        </rxui:RoutedViewHost>
        
        <Panel x:Name="ScreenDarkener"
               Background="Black"
               Opacity=".4"
               IsVisible="False"
               PointerReleased="ScreenDarkener_OnPointerReleased"/>
        
        <TransitioningContentControl Content="{Binding PopupContents}"
                                     PropertyChanged="PopupControl_OnPropertyChanged">
            
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.1"/>
            </TransitioningContentControl.PageTransition>
            
        </TransitioningContentControl>
    </Panel>
    
    
</Window>
