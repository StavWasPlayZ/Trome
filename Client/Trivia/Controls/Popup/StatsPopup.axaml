<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Trivia.Controls.Popup.StatsPopup">
    
    <Border
        CornerRadius="30"
        Background="#FFCACA"
        Width="300"
        Height="420">
        
        <Grid
            RowDefinitions="Auto, *, Auto">
            
            <Panel Grid.Row="0">
                
                <StackPanel Margin="20"
                            Spacing="5">
                    <Border
                        Background="#F3BBBB"
                        CornerRadius="20"
                        Width="80"
                        Height="80"
                        Padding="8">
                        
                        <Svg Path="avares://Trivia/Assets/Icons/person.svg"
                             Css="* { fill: #4D264A }"/>
                        
                    </Border>
                    
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="#4D264A"
                        FontSize="40">USERNAME</TextBlock>
                </StackPanel>
                
            </Panel>
            
            <StackPanel Grid.Row="1"
                        Spacing="5">
                
                <Grid ColumnDefinitions="150, *"
                      HorizontalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">POINTS</TextBlock>
                    <TextBlock Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7">69</TextBlock>
                </Grid>
                
                <Grid ColumnDefinitions="150, *"
                      HorizontalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">POINTS</TextBlock>
                    <TextBlock Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7">69</TextBlock>
                </Grid>
                
                <Grid ColumnDefinitions="150, *"
                      HorizontalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">POINTS</TextBlock>
                    <TextBlock Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7">69</TextBlock>
                </Grid>
                
                <Grid ColumnDefinitions="150, *"
                      HorizontalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               FontSize="30"
                               Foreground="#813E7A">POINTS</TextBlock>
                    <TextBlock Grid.Column="1"
                               FontSize="30"
                               Foreground="#BE64B7">69</TextBlock>
                </Grid>
                
            </StackPanel>
            
            <Panel Grid.Row="2">
                
                <Button HorizontalAlignment="Center"
                        Margin="0 40"
                        Width="150"
                        CornerRadius="5"
                        Background="#4D264A"
                        ClipToBounds="False">
                    
                    <Button.Styles>
                        <Style Selector="Button /template/ ContentPresenter">
                            <Setter Property="BoxShadow" Value="0 3 4 #3f000000"></Setter>
                        </Style>
                        
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#5A2757"></Setter>
                        </Style>
                        
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#50214E"></Setter>
                        </Style>
                    </Button.Styles>
                    
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0"
                                   Padding="10 0">X</TextBlock>
                        <TextBlock Grid.Column="1"
                                   TextAlignment="Center">CLOSE</TextBlock>
                    </Grid>
                    
                </Button>
                
            </Panel>
            
        </Grid>
        
    </Border>
    
</UserControl>
