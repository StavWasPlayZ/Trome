<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Trivia.Controls.Popups">
    <Design.PreviewWith>
        <controls:StatsPopup />
    </Design.PreviewWith>

    <Style Selector="controls|StatsPopup">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                
                <Border CornerRadius="30"
                        Background="#FFCACA"
                        Width="325"
                        Height="400"
                        VerticalAlignment="Center">
                    
                    <Panel>
                        <DockPanel Margin="50">

                            <StackPanel DockPanel.Dock="Top"
                                        Margin="0 0 0 20"
                                        Spacing="10">
                                <Border
                                    Background="#F3BBBB"
                                    CornerRadius="20"
                                    Width="80"
                                    Height="80"
                                    Padding="8">
                                        
                                    <Svg Path="avares://Trivia/Assets/Icons/person.svg"
                                         Css="* { fill: #4D264A }"/>
                                        
                                </Border>
                                    
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="#4D264A"
                                    FontSize="40">USERNAME</TextBlock>
                            </StackPanel>

                            <Grid VerticalAlignment="Bottom"
                                  RowDefinitions="Auto, 5, Auto, 5, Auto, 5, Auto"
                                  ColumnDefinitions="*, Auto">
                                
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           FontSize="30"
                                           Foreground="#813E7A">POINTS</TextBlock>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           FontSize="30"
                                           Foreground="#BE64B7">69</TextBlock>
                                
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           FontSize="30"
                                           Foreground="#813E7A">AVG. TIME/Q</TextBlock>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           FontSize="30"
                                           Foreground="#BE64B7">69</TextBlock>
                                
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           FontSize="30"
                                           Foreground="#813E7A">ANSWERED</TextBlock>
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           FontSize="30"
                                           Foreground="#BE64B7">69</TextBlock>
                                
                                <TextBlock Grid.Row="6"
                                           Grid.Column="0"
                                           FontSize="30"
                                           Foreground="#813E7A">CORRECT</TextBlock>
                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           FontSize="30"
                                           Foreground="#BE64B7">69</TextBlock>
                                
                            </Grid>

                        </DockPanel>
                        
                        <Button Command="{TemplateBinding CloseCommand}"
                                Theme="{StaticResource EmptyButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="20">
                            <TextBlock Foreground="#4d264a"
                                       FontSize="40">
                                X
                            </TextBlock>
                        </Button>
                    </Panel>
                    
                </Border>
                
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
