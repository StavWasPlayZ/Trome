<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Trivia.Controls.ListEntries"
        xmlns:controls1="clr-namespace:Trivia.Controls"
        xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
        xmlns:models="clr-namespace:Trivia.Models.User"
        xmlns:raw="clr-namespace:Trivia.Models.Raw">
    <Design.PreviewWith>
        <controls1:TriviaUsersList>
            <ListBox Width="350">

                <ListBox.ItemsSource>
                    <generic:List x:TypeArguments="models:UserScoreModel">
                        <models:UserScoreModel Place="1"
                                               Points="69420">
                            
                            <models:UserScoreModel.User>
                                <raw:User Username="USERNAME"
                                                Id="1"/>
                            </models:UserScoreModel.User>
                            
                        </models:UserScoreModel>
                        
                        <models:UserScoreModel Place="2"
                                               Points="69420">
                            
                            <models:UserScoreModel.User>
                                <raw:User Username="USERNAME"
                                                Id="1"/>
                            </models:UserScoreModel.User>
                            
                        </models:UserScoreModel>
                        
                        <models:UserScoreModel Place="3"
                                               Points="69420">
                            
                            <models:UserScoreModel.User>
                                <raw:User Username="USERNAME"
                                                Id="1"/>
                            </models:UserScoreModel.User>
                            
                        </models:UserScoreModel>
                    </generic:List>
                </ListBox.ItemsSource>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:ScoredUserListEntry Scores="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>
            
        </controls1:TriviaUsersList>
    </Design.PreviewWith>
    

    <Style Selector="controls|ScoredUserListEntry">
        <!-- Set Defaults -->
        <Setter Property="Background" Value="#9d4d95"/>
        <Setter Property="Padding" Value="10 10"/>
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    
                    <Grid ColumnDefinitions="Auto, Auto, Auto, *">
                                            
                        <TextBlock Classes="secondary-text"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="25"
                                   Margin="5 0 2 0"
                                   Width="25"
                                   TextAlignment="End"
                                   Text="{Binding $parent[controls:ScoredUserListEntry].Scores.Place, StringFormat={}{0}.}"/>

                        <Border x:Name="PART_Pfp"
                                Grid.Column="1"
                                CornerRadius="10"
                                Margin="10 0 15 0">

                            <Svg Path="avares://Trivia/Assets/Icons/person.svg"/>
                        </Border>

                        <TextBlock Classes="primary-text"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   Text="{
                                       Binding Scores.User.Username,
                                       RelativeSource={RelativeSource TemplatedParent}
                                   }"/>
                    
                        <TextBlock Classes="secondary-text"
                                   Grid.Column="3"
                                   VerticalAlignment="Center"
                                   TextAlignment="End"
                                   FontSize="30"
                                   Text="{
                                       Binding Scores.Points,
                                       RelativeSource={RelativeSource TemplatedParent}
                                   }"/>

                    </Grid>
                    
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ Border#PART_Pfp">
            <Setter Property="Background" Value="#ffbcf8"/>
            
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="6"/>
                                            
            <Style Selector="^ > Svg">
                <Setter Property="Css" Value="* { fill: #813e7a; }"/>
            </Style>
        </Style>
                                        
        <Style Selector="^ TextBlock.primary-text, ^ TextBlock.secondary-text">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
    </Style>
    
    <Style Selector="controls1|TriviaUsersList ListBoxItem">
        <Style Selector="^:pointerover > controls|ScoredUserListEntry">
            <Setter Property="Background" Value="#B456AB"/>
        </Style>
        <Style Selector="^:pressed > controls|ScoredUserListEntry">
            <Setter Property="Background" Value="#85437D"/>
        </Style>
        
            
        <Style Selector="^:nth-child(1) > controls|ScoredUserListEntry">
            <Setter Property="CornerRadius" Value="25 25 0 0"/>
        </Style>
        <Style Selector="^:nth-last-child(1) > controls|ScoredUserListEntry">
            <Setter Property="CornerRadius" Value="0 0 25 25"/>
        </Style>
        <Style Selector="^:nth-child(1):nth-last-child(1) > controls|ScoredUserListEntry">
            <Setter Property="CornerRadius" Value="25 25 25 25"/>
        </Style>
    </Style>
</Styles>
