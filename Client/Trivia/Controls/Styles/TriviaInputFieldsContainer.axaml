<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Trivia.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    
    <Style Selector="Grid.t-input-fields-container">
        
        <Style Selector="^ controls|TriviaTextBox[(Grid.Column)=1]">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="100 0 0 0"/>
            <Setter Property="Background" Value="#33EF657C"/>
                            
            <Style Selector="^ TextBox">
                <Setter Property="TextAlignment" Value="Start"/>
                <Setter Property="Margin" Value="10 5"/>
                <Setter Property="CaretBrush" Value="White"/>
            </Style>
        </Style>
        
        
        <Style Selector="^ > StackPanel.required-field">
            <Setter Property="Orientation" Value="Horizontal"/>
                            
            <Style Selector="^ TextBlock:nth-child(2)">
                <Setter Property="Text" Value="*" />
                <Setter Property="Foreground" Value="Red" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="2 0" />
            </Style>
        </Style>
        
    </Style>
    
</Styles>
