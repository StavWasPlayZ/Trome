<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Trivia.Controls">
    <Design.PreviewWith>
        <StackPanel>
            <controls:TriviaButton
                IconSvgPath="avares://Trivia/Assets/Icons/play_arrow.svg"/>
            
            <controls:TriviaButton
                IconSvgPath="avares://Trivia/Assets/Icons/play_arrow.svg"
                IconColor="#ffb0b0"/>
            
            <controls:TriviaButton HorizontalAlignment="Left"
                                   IsIconButton="True"
                                   IconSvgPath="avares://Trivia/Assets/Icons/settings.svg"/>
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|TriviaButton">
        <!-- Set Defaults -->
        <Setter Property="ClipToBounds" Value="False"></Setter>
        
        <Setter Property="Text" Value="TEXT"></Setter>
        <Setter Property="Height" Value="60"></Setter>
        <Setter Property="BorderBrush" Value="White"></Setter>
        <Setter Property="BorderThickness" Value="2"></Setter>
        <Setter Property="Background" Value="#211c2c"></Setter>
        
        <Setter Property="IconMargin" Value="0 13 0 13"></Setter>
        <Setter Property="IsIconButton" Value="False"></Setter>
        <Setter Property="IconColor" Value="White"></Setter>
        
        <Style Selector="^[IsIconButton=False]">
            <Setter Property="Padding" Value="15 0 15 0"></Setter>
        </Style>
        <Style Selector="^[IsIconButton=True]">
            <Setter Property="Padding" Value="13 0 13 0"></Setter>
        </Style>
        
        
        <Setter Property="BorderBrushSelected" Value="#A33E75"></Setter>
        <Setter Property="BackgroundSelected" Value="#1E132C"></Setter>
        <Setter Property="BorderThicknessSelected" Value="4"></Setter>
        
        <!-- <Setter Property="BorderBrushSelected" Value="#1E132C"></Setter> -->
        <!-- <Setter Property="BackgroundSelected" Value="#ae2c4d"></Setter> -->
        <!-- <Setter Property="BorderThicknessSelected" Value="6"></Setter> -->
        
        
        <Style Selector="^ /template/ Border">
            
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{TemplateBinding BackgroundSelected}"/>
                <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrushSelected}"/>
                <Setter Property="BorderThickness" Value="{TemplateBinding BorderThicknessSelected}"/>
                <Setter Property="BoxShadow" Value="0 6 7 0 #5f000000"/>
            </Style>
            
        </Style>
        
        
        <!-- Actual button -->
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    Height="{TemplateBinding Height}"
                    ClipToBounds="False">
                
                    <Grid ColumnDefinitions="Auto, *">
                        <Svg Grid.Column="0"
                             Path="{TemplateBinding IconSvgPath}"
                             Margin="{TemplateBinding IconMargin}">
                                
                            <Svg.Css>
                                <MultiBinding StringFormat="* {{ fill: {0}; }}">
                                    <Binding Path="IconColor"
                                             RelativeSource="{RelativeSource TemplatedParent}"
                                             Converter="{StaticResource SolidColorBrushToHexStrConverter}"/>
                                </MultiBinding>
                            </Svg.Css>
                                
                        </Svg>

                        <!-- Bottom padding is due to font itself. -->
                        <TextBlock Grid.Column="1"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Text}"
                                   TextAlignment="Center"
                                   Margin="0 0 0 5"
                                   
                                   IsVisible="{
                                       TemplateBinding IsIconButton,
                                       Converter={x:Static BoolConverters.Not}
                                   }"/>
                    </Grid>
                    
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
