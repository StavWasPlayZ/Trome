<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Trivia.Controls">
    <Design.PreviewWith>
        <controls:TriviaButton />
    </Design.PreviewWith>

    <Style Selector="controls|TriviaButton">
        <!-- Set Defaults -->
        <Setter Property="Text" Value="TEXT"></Setter>
        <Setter Property="Height" Value="47"></Setter>
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="5"
                    Background="#211c2c"
                    Padding="22 0 22 0"
                    Height="{TemplateBinding Height}">
                
                    <TextBlock
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{TemplateBinding Text}"/>
                
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
