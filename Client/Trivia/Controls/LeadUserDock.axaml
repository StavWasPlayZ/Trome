<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Trivia.Controls">
    <Design.PreviewWith>
        <StackPanel Background="Red"
                    Spacing="5">
            <controls:LeadUserDock Username="Username"/>
            <controls:LeadUserDock />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|LeadUserDock">
        <Setter Property="Template">
            <ControlTemplate>
            
                <Border
                    Padding="2,5,6,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CornerRadius="0,0,10,0"
                    Background="rgba(0, 0, 0, .3)">
                
                    <Grid ColumnDefinitions="*, Auto">
                    
                        <Svg Grid.Column="0"
                             Path="avares://Trivia/Assets/Icons/crown.svg"
                             Css="* { fill: #FFB43B; }"
                             Height="40"
                             Margin="0,0,10,0"/>
                    
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Username,
                                       RelativeSource={RelativeSource TemplatedParent},
                                       TargetNullValue=---------
                                   }"/>
                    
                    </Grid>
                
                </Border>
                
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
