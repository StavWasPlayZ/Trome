        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Auth\SignupView.axaml.cs">
        <DependentUpon>SignupView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Menu\JoinRoomMenuView.axaml.cs">
        <DependentUpon>JoinRoomMenuView.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Views\Menu\StatisticsView.axaml.cs">
